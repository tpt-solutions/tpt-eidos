{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "eidos",
  "scopeName": "source.eidos",
  "fileTypes": ["eidos"],
  "patterns": [
    { "include": "#doc_comments" },
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#strings" },
    { "include": "#function_def" },
    { "include": "#type_alias" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "doc_comments": {
      "name": "comment.line.documentation.eidos",
      "match": "///.*$"
    },
    "comments": {
      "name": "comment.line.double-slash.eidos",
      "match": "//.*$"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.eidos",
          "match": "\\b(if|else|return|let)\\b"
        },
        {
          "name": "keyword.declaration.eidos",
          "match": "\\b(fn|type)\\b"
        },
        {
          "name": "keyword.contract.eidos",
          "match": "\\b(requires|ensures|effects)\\b"
        },
        {
          "name": "keyword.other.eidos",
          "match": "\\b(as|linear)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.eidos",
          "match": "\\b(f64|f32|i64|i32|i8|u64|u32|u8|bool|char|Unit)\\b"
        },
        {
          "name": "support.type.collection.eidos",
          "match": "\\bArray\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.eidos",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.eidos",
          "match": "<=|>=|==|!=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.eidos",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.arrow.eidos",
          "match": "->"
        },
        {
          "name": "keyword.operator.lambda.eidos",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.refinement.eidos",
          "match": "\\|(?=[a-zA-Z_])"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.eidos",
      "match": "\\b[0-9]+(\\.([0-9]+)?)?([eE][+-]?[0-9]+)?\\b"
    },
    "booleans": {
      "name": "constant.language.boolean.eidos",
      "match": "\\b(true|false)\\b"
    },
    "strings": {
      "name": "string.quoted.double.eidos",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.eidos",
          "match": "\\\\."
        }
      ]
    },
    "function_def": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "keyword.declaration.eidos" },
        "2": { "name": "entity.name.function.eidos" }
      }
    },
    "type_alias": {
      "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)\\s*=",
      "captures": {
        "1": { "name": "keyword.declaration.eidos" },
        "2": { "name": "entity.name.type.eidos" }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.eidos",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.eidos",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
